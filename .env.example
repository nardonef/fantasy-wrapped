# Postgres connection string.
# Local dev (Homebrew Postgres): postgres://<your-user>@localhost:5432/fantasy_wrapped
DATABASE_URL=postgres://localhost:5432/fantasy_wrapped

# Separate database for integration tests (name must contain "test").
TEST_DATABASE_URL=postgres://localhost:5432/fantasy_wrapped_test

# Anthropic API key — required for the copy layer (Phase 3+). Optional until then.
ANTHROPIC_API_KEY=
