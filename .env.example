# Postgres connection string.
# Local dev (Homebrew Postgres): postgres://<your-user>@localhost:5432/fantasy_wrapped
DATABASE_URL=postgres://localhost:5432/fantasy_wrapped

# Separate database for integration tests (name must contain "test").
TEST_DATABASE_URL=postgres://localhost:5432/fantasy_wrapped_test

# Anthropic API key — required for the copy layer (Phase 3+). Optional until then.
ANTHROPIC_API_KEY=

# PostHog. Project Settings → Project API Key, after creating a free project
# at posthog.com. This token is a write-only client-side ingestion token, not
# a secret — safe to expose in the browser bundle. Left unset, capture is a
# no-op (see instrumentation-client.ts).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Relative path so requests go through the next.config.ts reverse proxy
# instead of directly to posthog.com (ad blockers otherwise drop them).
NEXT_PUBLIC_POSTHOG_HOST=/ingest
