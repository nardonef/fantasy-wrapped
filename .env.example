# Postgres connection string.
# Local dev (Homebrew Postgres): postgres://<your-user>@localhost:5432/fantasy_wrapped
DATABASE_URL=postgres://localhost:5432/fantasy_wrapped

# Separate database for integration tests (name must contain "test").
TEST_DATABASE_URL=postgres://localhost:5432/fantasy_wrapped_test

# Anthropic API key — required for the copy layer (Phase 3+). Optional until then.
ANTHROPIC_API_KEY=

# Yahoo Fantasy Sports OAuth (Phase 6). Register an app at
# https://developer.yahoo.com/apps/create/ with the "Fantasy Sports" (read)
# permission checked. Yahoo requires an HTTPS redirect_uri — no localhost —
# so YAHOO_REDIRECT_URI should point at a deployed Vercel URL, not
# http://localhost:3000, and must match byte-for-byte what's registered.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=

# 32 raw bytes, base64-encoded (openssl rand -base64 32). Encrypts the
# short-lived cookie that bridges the OAuth access token from the callback
# to the sync click — see docs/superpowers/specs/2026-08-11-yahoo-integration-design.md.
# Generate once; rotating it just invalidates any in-flight connect attempt.
YAHOO_COOKIE_SECRET=

# PostHog. Project Settings → Project API Key, after creating a free project
# at posthog.com. This token is a write-only client-side ingestion token, not
# a secret — safe to expose in the browser bundle. Left unset, capture is a
# no-op (see instrumentation-client.ts).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Relative path so requests go through the next.config.ts reverse proxy
# instead of directly to posthog.com (ad blockers otherwise drop them).
NEXT_PUBLIC_POSTHOG_HOST=/ingest
